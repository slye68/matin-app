{
  "name": "matin-app",
  "version": "1.0.0",
  "description": "Mon Matin — Tableau de bord du matin pour Windows",
  "main": "main/main.js",
  "author": "Mon Matin",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:msix": "electron-builder --win appx"
  },
  "dependencies": {
    "dotenv": "^9.0.2",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "interactjs": "^1.10.27",
    "node-tradfri-client": "^3.2.0",
    "tplink-smarthome-api": "^5.0.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.monmatin.app",
    "productName": "Mon Matin",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "generic",
      "url": "https://monmatinapp.netlify.app/"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "renderer/assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
